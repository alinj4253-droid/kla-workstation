{
  "name": "@kla-workstation/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @kla-workstation/contracts build",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/database/migrate-cli.ts",
    "db:sync-documents": "tsx src/database/sync-documents-cli.ts",
    "db:grant": "tsx src/database/grant-documents-cli.ts",
    "db:seed-company-base": "tsx src/database/seed-company-base-cli.ts",
    "points:migrate": "tsx scripts/migrate-points.ts",
    "points:reconcile": "tsx scripts/reconcile-points.ts",
    "points:revalue": "tsx scripts/revalue-points.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "pretest": "pnpm --filter @kla-workstation/contracts build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kla-workstation/contracts": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/sensible": "^6.0.3",
    "dotenv": "^18.0.4",
    "fastify": "^5.6.1",
    "pg": "^8.23.0",
    "redis": "^5.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
