NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://kla:kla@localhost:5432/kla
DATABASE_SCHEMA=kla
REDIS_URL=redis://192.168.0.57:6379/4
# S3/MinIO 预留参数；当前 ObjectStore 使用下面的 OBJECT_STORAGE_PATH，尚不读取这些参数
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=kla-workstation
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# 本地开发/单机部署的持久化对象存储目录；生产环境应挂载共享持久卷
OBJECT_STORAGE_PATH=.runtime/object-storage
OBJECT_STORAGE_MAX_FILE_BYTES=104857600
VECTOR_STORE_URL=
SUB2API_BASE_URL=
SUB2API_API_KEY=
# Sub2API 管理员 API Key（建号/调额/查用量），优先于 SUB2API_API_KEY
SUB2API_ADMIN_API_KEY=
# Sub2API 请求超时（毫秒）
SUB2API_TIMEOUT_MS=15000
# 模型生成调用上限（毫秒）；只限制单次调用，不限制整个智能体任务
SUB2API_MODEL_TIMEOUT_MS=60000
SUB2API_TOOL_MODEL_TIMEOUT_MS=300000
# 每个可恢复执行步骤的最大模型轮次；整个任务没有总轮次限制
AGENT_STEP_MAX_TURNS=64
# 积分管理后台账号（生产环境必须改成随机强密码）
POINTS_ADMIN_USERNAME=admin
POINTS_ADMIN_PASSWORD=replace-with-a-long-random-password
# Sub2API 默认分组 ID
SUB2API_DEFAULT_GROUP_ID=
# 个人身份默认分组 ID
SUB2API_PERSONAL_GROUP_ID=
# 高速模型分组 ID
SUB2API_FAST_GROUP_ID=
# 托管账号内部邮箱域名（Sub2API 以 email 作为账号标识，KLA 用确定性用户名拼出该域名）
SUB2API_ACCOUNT_EMAIL_DOMAIN=kla.internal
# 算力模块配置
COMPUTE_USAGE_SYNC_INTERVAL_MS=60000
COMPUTE_OUTBOX_INTERVAL_MS=5000
COMPUTE_RECONCILIATION_ENABLED=false
# 字段级加密密钥（32 字节 hex 或 base64），用于托管密码加密
COMPUTE_SECRET_ENCRYPTION_KEY=
# Model Gateway 预扣下限（美元，预扣时按汇率换算为算力点），调用前的软额度闸门金额
COMPUTE_MIN_RESERVE_USD=0.01
# 算力点汇率：1 USD = N 点（1 元 = 1 美元 = 1000 积分；调整 = 发版 + 存量重估迁移）
POINTS_PER_USD=1000

# 工具类计费项（docs/DESIGN_BOCHA_SEARCH_INTEGRATION.md）
# 博查 Web Search API Key：平台统一持有，仅服务端使用，绝不下发客户端
BOCHA_API_KEY=

# Knowledge pipeline adapter (API keys remain encrypted on the server)
KNOWLEDGE_BASE_URL=http://192.168.10.206:8120
KNOWLEDGE_SECRET_ENCRYPTION_KEY=
