VITE_API_BASE_URL=http://localhost:8787/api
VITE_API_MODE=placeholder

VITE_KNOWLEDGE_BASE_URL=http://192.168.10.206:8120

# Electron 主进程环境变量（启动 Electron 前设置，不能加 VITE_ 前缀）
# 默认使用 setup-ppt-runtime.ps1 安装的用户级虚拟环境；不填写也可。
# KLA_PPT_PYTHON=C:/Users/YourName/AppData/Local/kla-workstation/ppt-runtime/Scripts/python.exe

# 以下同样是 Electron 主进程变量，请在启动 Electron 的 shell 或部署脚本中设置。
# Vite 不会将此 .env 文件中的非 VITE_ 项自动注入 Electron 进程。
# KLA_LOCAL_WORKSPACE_ROOT=C:/Users/YourName/AppData/Roaming/kla-workstation/agent-runtime
# KLA_LOCAL_WORKSPACE_TTL_HOURS=24
# KLA_LOCAL_WORKSPACE_MAX_BYTES=2147483648
# KLA_LOCAL_ALLOWED_ROOTS=C:/Work;D:/Projects
# KLA_LOCAL_ARTIFACT_UPLOAD=true
