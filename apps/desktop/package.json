    "@radix-ui/react-tabs": "^1.1.6",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.45.1",
    "cytoscape": "^3.34.0",
    "dompurify": "^3.4.12",
    "echarts": "5.4.3",
    "lucide-react": "^1.24.0",
    "pptx-preview": "1.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.0.1",
    "react-router-dom": "^7.18.1",
