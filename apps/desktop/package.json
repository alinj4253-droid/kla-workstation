{
  "name": "@kunqing/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-rebuild -f -w better-sqlite3 && electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-rebuild -f -w better-sqlite3 && electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node-gyp rebuild -C ./node_modules/better-sqlite3 2>nul & vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/ --config vitest.config.ts",
    "licenses": "node scripts/generate-licenses.mjs",
    "package:win": "pnpm build && node scripts/generate-licenses.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^4.0.16",
    "@kunqing/agent-core": "workspace:*",
    "@kunqing/channel-core": "workspace:*",
    "@kunqing/database": "workspace:*",
    "@kunqing/knowledge-core": "workspace:*",
    "@kunqing/memory-core": "workspace:*",
    "@kunqing/model-core": "workspace:*",
    "@kunqing/native-agent-core": "workspace:*",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@radix-ui/react-dialog": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.6",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "ai": "^7.0.31",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.0",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "openai": "^6.48.0",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.18.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "ulid": "^3.0.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
