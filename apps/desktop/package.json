{
  "name": "@kla-workstation/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "predev": "pnpm --filter @kla-workstation/contracts build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
