{
  "name": "kunqing-agent-workstation",
  "version": "0.1.0",
  "private": true,
  "description": "鲲擎多智能体集成工作站",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kunqing/desktop dev",
    "dev:web": "pnpm --filter @kunqing/desktop dev:web",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @kunqing/desktop test",
    "test:watch": "pnpm --filter @kunqing/desktop test:watch",
    "lint": "eslint .",
    "ci-check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "licenses": "pnpm --filter @kunqing/desktop licenses",
    "package:win": "pnpm --filter @kunqing/desktop package:win"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3"
  }
}
