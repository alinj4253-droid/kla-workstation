# /etc/kla/server.env — environment for the KLA server (systemd EnvironmentFile).
# Format: KEY=value (no quotes, no `export`). chmod 640 root:kla.

NODE_ENV=production
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# --- Required: data stores ---
DATABASE_URL=postgres://kla:CHANGE_ME@127.0.0.1:5432/kla
DATABASE_SCHEMA=kla
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# --- Required: object storage (attachments, shared artefacts) ---
OBJECT_STORAGE_PATH=/home/kla/object-storage
OBJECT_STORAGE_MAX_FILE_BYTES=104857600

# --- Required: secret encryption keys ---
# MUST reuse the value from the previous environment. Stored ciphertexts
# (managed credentials, knowledge credentials) depend on this key and cannot
# be regenerated. If the previous environment had no separate knowledge key,
# it falls back to the compute key.
COMPUTE_SECRET_ENCRYPTION_KEY=CHANGE_ME
#KNOWLEDGE_SECRET_ENCRYPTION_KEY=CHANGE_ME

# --- Required: Sub2API (model gateway upstream) ---
SUB2API_BASE_URL=CHANGE_ME
SUB2API_ADMIN_API_KEY=CHANGE_ME
SUB2API_DEFAULT_GROUP_ID=CHANGE_ME
SUB2API_PERSONAL_GROUP_ID=CHANGE_ME
SUB2API_FAST_GROUP_ID=CHANGE_ME
#SUB2API_TIMEOUT_MS=15000
#SUB2API_ACCOUNT_EMAIL_DOMAIN=kla.internal

# --- Required: points administration ---
# Used by apps/points-admin to authenticate platform operators.
POINTS_ADMIN_USERNAME=CHANGE_ME
POINTS_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM
# 1 USD = 1000 points; keep this value unless the points ledger is migrated.
POINTS_PER_USD=1000

# --- Required: docker compose init for PG/Redis (not read by the server itself) ---
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- Optional: knowledge base ---
# Default: http://192.168.10.206:8120
#KNOWNLEDGE_BASE_URL=http://192.168.10.206:8120

# --- Optional: compute / billing tuning ---
#COMPUTE_USAGE_SYNC_INTERVAL_MS=5000
#COMPUTE_OUTBOX_INTERVAL_MS=5000
#COMPUTE_RECONCILIATION_ENABLED=false
#COMPUTE_MIN_RESERVE_USD=0.01

# --- Optional: agent behaviour ---
#AGENT_STEP_MAX_TURNS=64

# --- Optional: platform-held model keys (server-side only) ---
#BOCHA_API_KEY=
#DEEPSEEK_API_KEY=
#GLM_API_KEY=
#MODEL_API_KEY=
#MODEL_ID=
#QWEN_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
